{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UDF Resimcisi",
  "version": "1.2.0",
  "identifier": "com.cagrisahin.udfresimcisi",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "UDF Resimcisi",
        "width": 980,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Çağrı Şahin",
    "copyright": "MIT",
    "category": "Productivity",
    "shortDescription": "Resimden tam çözünürlüklü UDF üretir",
    "longDescription": "Fotoğraf veya ekran görüntüsünü, UYAP Doküman Editörü'nün küçültmesine uğratmadan, tam çözünürlükle bir .udf belgesine yerleştirir.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["tr-TR"]
      },
      "nsis": {
        "languages": ["Turkish"],
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
